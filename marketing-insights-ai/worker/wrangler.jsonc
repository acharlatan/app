{
  "name": "marketing-insights-ai",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "AI_ENABLED": "true",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "ALLOWED_ORIGINS": "https://acharlatan.github.io,http://localhost:8000,http://127.0.0.1:8000"
  },
  "ratelimits": [
    {
      "name": "PER_IP",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USAGE",
        "class_name": "UsageGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "UsageGuard"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
